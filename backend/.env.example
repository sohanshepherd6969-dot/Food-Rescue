# Copy to .env and fill in. Never commit .env.
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foodrescue?retryWrites=true&w=majority
JWT_SECRET=<long random string, e.g. output of: openssl rand -hex 32>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Deployed frontend URL(s), comma-separated, e.g. https://foodrescue.vercel.app
CLIENT_ORIGIN=
# The Super Admin is created from these on server start / seed (public sign-up can't create admins).
ADMIN_EMAIL=admin@foodrescue.demo
ADMIN_PASSWORD=<choose a strong password>
# Optional: password for the seeded demo donors/distributors (default Demo@1234)
DEMO_PASSWORD=
